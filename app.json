{
  "expo": {
    "name": "Ashwamedh Agro Mart",
    "slug": "AshwamedhAgroMart",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ashwamedhagromart",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/ios-icon-light.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ashwamedhagromart"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ashwamedhagromart",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "process.env.EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY",
          "iosGoogleMapsApiKey": "process.env.EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/images/icon.png"
          },
          "imageWidth": 76
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ashwamedh Agro Mart uses your location while the app is open to find your area when you tap “Use current location”, so you can set your delivery address on the map. The location you confirm is saved with that address so your orders can be delivered to you. We do not track your location in the background.",
          "locationAlwaysAndWhenInUsePermission": "Ashwamedh Agro Mart only uses your location while the app is open, to set your delivery address when you tap “Use current location”. We do not track your location in the background.",
          "locationAlwaysPermission": "Ashwamedh Agro Mart only uses your location while the app is open, to set your delivery address when you tap “Use current location”. We do not track your location in the background.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Ashwamedh Agro Mart uses your camera to take a photo of your crop for AI Crop Doctor.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Ashwamedh Agro Mart uses your camera to take a photo of your crop for AI Crop Doctor.",
          "photosPermission": "Ashwamedh Agro Mart reads a photo you choose so AI Crop Doctor can check your crop.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a2963e2-eb8f-4a99-8773-a4309f3b27e0"
      }
    },
    "owner": "ashwamedhgroup",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7a2963e2-eb8f-4a99-8773-a4309f3b27e0"
    }
  }
}
